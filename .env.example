# Google Gemini — https://aistudio.google.com/apikey
# Used for brief generation, round refinement, and taste notes (lib/gemini/*)
GEMINI_API_KEY=

# TMDB — https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# OMDb — https://www.omdbapi.com/apikey.aspx (free tier; used for real IMDb ratings)
OMDB_API_KEY=

# RapidAPI — whichever India OTT-availability API you're subscribed to.
# lib/streamingAvailability/client.ts is currently built against movie-of-the-night's
# "Streaming Availability API" (streaming-availability.p.rapidapi.com); if you're on a
# different provider (e.g. "OTT details"), that client needs updating to match its contract.
RAPID_API_KEY=
RAPID_API_HOST=

# Supabase — Project Settings > API (new-format `sb_publishable_...` / `sb_secret_...` keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
